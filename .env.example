# Database Configuration (for local development)
# DATABASE_URL="postgresql://username:password@localhost:5432/newsly_db"
DB_HOST="localhost"
DB_PORT=5432
DB_USERNAME="postgres"
DB_PASSWORD="password"
DB_NAME="newsly_db"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"

# Server Configuration
PORT=3000
NODE_ENV="development"

# For Render deployment:
# 1. DATABASE_URL will be automatically provided by Render PostgreSQL addon
# 2. Set NODE_ENV=production
# 3. Set JWT_SECRET to a secure random string
# 4. PORT will be automatically set by Render
